NEXT_PUBLIC_API_URL=http://localhost:8000

# From Clerk dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Sentry error tracking (frontend). Use the SAME Sentry account/project as
# the backend, but its own DSN — sentry.io -> your project -> Settings ->
# Client Keys (DSN). Leave blank to disable (no build-time requirement,
# safe to leave empty).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development

# Optional, only needed for readable (non-minified) stack traces in the
# Sentry UI in production. From sentry.io -> Settings -> Auth Tokens.
# Skip these for now — everything still works without them.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
