# Get a free key at https://aistudio.google.com/apikey (no credit card required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use. flash is fast + free-tier friendly.
GEMINI_MODEL=gemini-flash-latest

# SQLite for a zero-setup local run (used automatically for the test suite
# too). For real/shared use, point this at Postgres instead — e.g. a free
# Neon/Supabase/Railway instance:
#   DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/netagent
# Note the driver is "+asyncpg", not the "postgres://" or "postgresql://"
# string those dashboards give you by default — swap the scheme, and drop
# any trailing "?sslmode=require" (SSL is enabled automatically instead;
# asyncpg doesn't understand that query parameter).
#
# After setting DATABASE_URL to Postgres, create the tables once with:
#   alembic upgrade head
# (SQLite creates its own tables automatically on startup; Postgres does
# not — its schema is owned by Alembic from here on, see migrations/.)
DATABASE_URL=sqlite+aiosqlite:///./data/netagent.db

# Where the Chroma vector store persists on disk
CHROMA_PERSIST_DIR=./chroma_store

# CORS origin(s) for the frontend. Comma-separated for multiple — e.g. keep
# localhost for your own dev machine AND add your deployed Vercel URL:
#   FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# Clerk instance issuer URL (Configure -> API Keys -> Advanced in the Clerk
# dashboard, or it's the domain embedded in your publishable key). Used to
# verify session tokens — no Clerk secret key needed for this.
# e.g. https://your-app-name.clerk.accounts.dev
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev

# Sentry error tracking. Leave blank to disable (no account needed for local
# dev/tests). To enable: create a free project at https://sentry.io ->
# choose "FastAPI" as the platform -> Settings -> Projects -> <project> ->
# Client Keys (DSN) -> copy the DSN URL here.
SENTRY_DSN=

# Shown as a tag on every Sentry event, so a local error doesn't get mixed
# in with real production ones. Use "production" when you actually deploy.
ENVIRONMENT=development
